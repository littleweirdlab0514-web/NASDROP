#!/bin/sh
set -eu

PID_FILE="${SYNOPKG_PKGVAR}/service.pid"
LOG_FILE="${SYNOPKG_PKGVAR}/service.log"
PYTHON="/usr/bin/python3"
APP="${SYNOPKG_PKGDEST}/backend.py"

is_running() {
  [ -f "$PID_FILE" ] || return 1
  pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

case "${1:-}" in
  start)
    if is_running; then exit 0; fi
    export NAS_PORTAL_STATE_DIR="${SYNOPKG_PKGVAR}"
    export NAS_PORTAL_STATIC_DIR="${SYNOPKG_PKGDEST}/web"
    export NAS_PORTAL_LAUNCHER_FILE="${SYNOPKG_PKGDEST}/ui/launcher.html"
    export NAS_PORTAL_LOG_FILE="$LOG_FILE"
    export NAS_PORTAL_LISTEN_HOST="0.0.0.0"
    export NAS_PORTAL_VERSION="0.7.15"
    export PATH="${SYNOPKG_PKGDEST}/bin:/usr/local/bin:/usr/bin:/bin"
    umask 077
    "$PYTHON" "$APP" >/dev/null 2>&1 &
    echo "$!" > "$PID_FILE"
    sleep 1
    is_running
    ;;
  stop)
    if is_running; then
      pid="$(cat "$PID_FILE")"
      kill "$pid" 2>/dev/null || true
      count=0
      while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 20 ]; do sleep 1; count=$((count + 1)); done
      kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
    ;;
  status)
    if is_running; then exit 0; fi
    exit 3
    ;;
  log)
    echo "$LOG_FILE"
    ;;
  *)
    exit 1
    ;;
esac
exit 0
