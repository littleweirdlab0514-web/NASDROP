#!/bin/sh
set -eu

config_path="${SYNOPKG_PKGVAR}/config.json"
if [ -f "$config_path" ]; then
  /usr/bin/python3 - "$config_path" <<'PY'
import json
import os
from pathlib import Path
import sys

path = Path(sys.argv[1])
try:
    data = json.loads(path.read_text(encoding="utf-8"))
except (OSError, json.JSONDecodeError):
    raise SystemExit(0)
changed = False
if isinstance(data, dict) and data.get("NAS_PORTAL_NAS_TARGET") == "/volume2/downloads":
    data["NAS_PORTAL_NAS_TARGET"] = ""
    changed = True
if isinstance(data, dict) and "NAS_PORTAL_LAUNCHER_PORT" not in data:
    data["NAS_PORTAL_LAUNCHER_PORT"] = "8791"
    changed = True
if changed:
    temporary = path.with_suffix(".migration")
    temporary.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.replace(temporary, path)
PY
  chmod 600 "$config_path"
fi

rm -f "${SYNOPKG_PKGVAR}/access_token"
launcher_secret="${SYNOPKG_PKGVAR}/dsm_launcher_secret"
if ! [ -s "$launcher_secret" ] || ! /usr/bin/python3 - "$launcher_secret" <<'PY'
from pathlib import Path
import sys
try:
    value = bytes.fromhex(Path(sys.argv[1]).read_text(encoding="ascii").strip())
except (OSError, UnicodeError, ValueError):
    raise SystemExit(1)
raise SystemExit(0 if len(value) == 32 else 1)
PY
then
  /usr/bin/python3 -c 'import secrets; print(secrets.token_hex(32))' > "$launcher_secret"
fi
chmod 600 "$launcher_secret"
cat > "${SYNOPKG_PKGDEST}/ui/launcher.html" <<EOF
<!doctype html>
<html><head><meta charset="utf-8"><title>NASDrop</title></head>
<body><script>
  var host = location.hostname;
  var plainHost = host.replace(/^\[|\]$/g, "").toLowerCase();
  var isV6 = plainHost.indexOf(":") !== -1;
  var privateHost = plainHost === "localhost" || plainHost === "::1" ||
    (!isV6 && (/^(127\.|10\.|192\.168\.)/.test(plainHost) ||
    /^172\.(1[6-9]|2[0-9]|3[01])\./.test(plainHost) ||
    plainHost.endsWith(".local") || plainHost.indexOf(".") === -1));
  var targetProtocol = location.protocol === "https:" ? "https://" : "http://";
  if (privateHost) targetProtocol = "http://";
  location.replace(targetProtocol + host + ":8791/");
</script></body></html>
EOF
chmod 644 "${SYNOPKG_PKGDEST}/ui/launcher.html"
exit 0
