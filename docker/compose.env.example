# Copy this file to the repository root as .env before running Docker Compose.
# On Linux and Synology, use `id your-user` to find the numeric IDs.
PUID=1000
PGID=1000
TZ=Asia/Seoul

# Host paths. Relative paths are resolved next to compose.yaml.
NASDROP_CONFIG_DIR=./nasdrop-config
NASDROP_DOWNLOAD_DIR=./downloads

# Use 8792 when the native Synology package still occupies port 8791.
NASDROP_PORT=8791
NASDROP_BIND_ADDRESS=0.0.0.0

# Keep false unless NASDrop is reachable only through a trusted local reverse proxy.
NASDROP_TRUST_FORWARDED_FOR=false
