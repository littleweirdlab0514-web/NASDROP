{
  "manifest_version": 3,
  "name": "NASDrop for Chrome",
  "version": "0.5.1",
  "icons": {"16":"icons/nasdrop-16.png", "32":"icons/nasdrop-32.png", "48":"icons/nasdrop-48.png", "256":"icons/nasdrop-256.png"},
  "minimum_chrome_version": "102",
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "alarms",
    "activeTab",
    "contextMenus",
    "notifications",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["https://*.gigafile.nu/*", "https://gofile.io/*", "https://www.gofile.io/*", "https://pixeldrain.com/*", "https://www.pixeldrain.com/*", "https://pixeldrain.net/*", "https://pixeldra.in/*", "https://buzzheavier.com/*", "https://www.buzzheavier.com/*", "https://akirabox.to/*/file", "https://akirabox.com/*/file", "https://vik1ngfile.site/f/*", "https://vikingfile.com/f/*"],
    "js": ["i18n.js", "provider-adapters.js", "content.js"],
    "run_at": "document_start"
  }],
  "action": {
    "default_icon": {"16":"icons/nasdrop-16.png", "32":"icons/nasdrop-32.png", "48":"icons/nasdrop-48.png"},
    "default_title": "NASDrop",
    "default_popup": "popup.html"
  }
}
